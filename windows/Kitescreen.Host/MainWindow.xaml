<Window x:Class="Kitescreen.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kitescreen" Icon="Assets/Kitescreen.ico" Width="820" Height="720" MinWidth="640" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0B1526" Foreground="#F8FAFC" FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PickerStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#0B1526"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ModeStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#22354C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Kitescreen" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="Connect your tablet as a Windows display" FontSize="16" Foreground="#CBD5E1" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#17263C" CornerRadius="14" Padding="20" Margin="0,24,0,0">
            <StackPanel x:Name="ConnectionOptions">
                <TextBlock Text="USB TABLET" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                <ComboBox x:Name="Devices" DisplayMemberPath="Display" Style="{StaticResource PickerStyle}"/>
                <TextBlock Text="DISPLAY MODE" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,22,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="MirrorMode" Content="Mirror" GroupName="DisplayMode" IsChecked="True" Style="{StaticResource ModeStyle}" Margin="0,0,30,0" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ExtendMode" Content="Extend (experimental)" GroupName="DisplayMode" Style="{StaticResource ModeStyle}" Checked="Mode_Checked"/>
                </StackPanel>
                <TextBlock x:Name="ModeHint" Text="Mirror shows an existing Windows screen on your tablet." TextWrapping="Wrap" FontSize="14" Foreground="#CBD5E1" Margin="0,8,0,0"/>
                <StackPanel Margin="0,20,0,0" IsEnabled="{Binding IsChecked, ElementName=MirrorMode}">
                    <TextBlock Text="WINDOWS SCREEN TO MIRROR" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                    <ComboBox x:Name="Displays" DisplayMemberPath="Display" Style="{StaticResource PickerStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="ConnectButton" Content="Connect tablet" Style="{StaticResource ActionStyle}" Background="#22D3EE" Foreground="#071A32" Click="Connect_Click"/>
            <Button x:Name="RefreshButton" Content="Refresh devices" Style="{StaticResource ActionStyle}" Margin="10,0,0,0" Click="Refresh_Click"/>
            <Button x:Name="DisconnectButton" Content="Stop" Style="{StaticResource ActionStyle}" Margin="10,0,0,0" IsEnabled="False" Click="Disconnect_Click"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#153341" CornerRadius="12" Padding="18,14" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="CONNECTION STATUS" FontWeight="SemiBold" Foreground="#D5F7FF" Margin="0,0,0,6"/>
                <TextBlock x:Name="Status" Text="Looking for your USB tablet…" TextWrapping="Wrap" FontSize="15" Foreground="#F8FAFC"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="Tip: Mirror works without a virtual display driver. Extend needs the experimental driver and Windows set to Extend."
                   VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="14" Foreground="#CBD5E1" Margin="0,18,0,0"/>
    </Grid>
</Window>
